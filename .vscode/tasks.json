{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Calva Compile",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile"],
      "isBackground": false,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva",
        "close": true
      }
    },
    {
      "label": "Calva Watch CLJS",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch-cljs"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(~never~)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "nREPL server started"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva REPL",
      "type": "shell",
      "command": "echo ${input:connectCalvaRepl}",
      "dependsOn": ["Calva Watch CLJS"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "never",
        "close": true
      }
    },
    {
      "label": "Calva Watch TS",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch-ts"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch Test TS",
      "type": "shell",
      "command": "npm",
      "args": ["run", "unit-test-watch"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": {
        // "owner": "mocha",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": [
          {
            "regexp": "^not\\sok\\s\\d+\\s(.*)$"
          },
          {
            "regexp": "\\s+(.*)$",
            "message": 1
          },
          {
            "regexp": "\\s+at\\s(.*)\\s\\((.*):(\\d+):(\\d+)\\)",
            "file": 2,
            "line": 3,
            "column": 4
          }
        ]
      },
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch Lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "eslint-watch"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$eslint-compact",
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch TS Format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "prettier-format-watch"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Calva Watchers",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": [
        "Calva Watch TS Format",
        "Calva Watch TS",
        "Calva REPL",
        "Calva Watch Test TS",
        "Calva Watch Lint"
      ]
    },
    {
      "label": "Calva Watch Docs",
      "type": "shell",
      "command": "clojure -Sdeps '{:deps {nrepl/nrepl {:mvn/version \"1.5.1\"} cider/cider-nrepl {:mvn/version \"0.58.0\"}}}' -M:dev -e '(require (quote calva.docs.serve)) (calva.docs.serve/start!)' -m nrepl.cmdline --middleware '[cider.nrepl/cider-middleware]'",
      "options": {
        "cwd": "${workspaceFolder}/docs-builder"
      },
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(~never~)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "nREPL server started"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "calvaDocs"
      }
    },
    {
      "label": "Calva Docs",
      "type": "shell",
      "command": "echo ${input:connectDocsRepl}",
      "dependsOn": ["Calva Watch Docs"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "never",
        "close": true
      }
    },
    {
      "label": "Calva Compile and Watch",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOrder": "sequence",
      "dependsOn": ["Calva Compile", "Calva Watchers"]
    },
    {
      "label": "Calva Dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["Calva Compile and Watch", "Calva Docs"]
    }
  ],
  "inputs": [
    {
      "id": "connectCalvaRepl",
      "type": "command",
      "command": "joyride.runCode",
      "args": "(require '[\"vscode\" :as vscode]) (vscode/commands.executeCommand \"calva.connect\" #js {:connectSequence \"Calva\"}) \"connecting\""
    },
    {
      "id": "connectDocsRepl",
      "type": "command",
      "command": "joyride.runCode",
      "args": "(require '[\"vscode\" :as vscode]) (vscode/commands.executeCommand \"calva.connect\" #js {:connectSequence \"Calva docs\"}) \"connecting\""
    }
  ]
}
