{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Calva Compile",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile"],
      "isBackground": false,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva",
        "close": true
      }
    },
    {
      "label": "Calva Watch CLJS",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch-cljs"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch TS",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch-ts"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch Test TS",
      "type": "shell",
      "command": "npm",
      "args": ["run", "unit-test-watch"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": {
        // "owner": "mocha",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": [
          {
            "regexp": "^not\\sok\\s\\d+\\s(.*)$"
          },
          {
            "regexp": "\\s+(.*)$",
            "message": 1
          },
          {
            "regexp": "\\s+at\\s(.*)\\s\\((.*):(\\d+):(\\d+)\\)",
            "file": 2,
            "line": 3,
            "column": 4
          }
        ]
      },
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch Lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "eslint-watch"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$eslint-compact",
      "presentation": {
        "panel": "dedicated",
        "group": "defaultCalva"
      }
    },
    {
      "label": "Calva Watch TS Format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "prettier-format-watch"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Calva Watchers",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": [
        "Calva Watch TS Format",
        "Calva Watch TS",
        "Calva Watch CLJS",
        "Calva Watch Test TS",
        "Calva Watch Lint"
      ]
    },
    {
      "label": "Calva Watch Docs",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch-docs"],
      "isBackground": true,
      "osx": {
        "options": {
          "shell": {
            "executable": "/bin/zsh",
            "args": ["-lic"]
          }
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Calva Dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOrder": "sequence",
      "dependsOn": ["Calva Compile", "Calva Watchers"]
    }
  ]
}
